{
    "name": "ruvelo/prestashop-security-alerts",
    "description": "Tells you, in the PrestaShop back office and by email, when PrestaShop itself or an installed module has a known vulnerability, and which are exploited in the wild.",
    "type": "prestashop-module",
    "license": "MIT",
    "keywords": ["prestashop", "security", "vulnerabilities", "advisories", "cisa-kev"],
    "homepage": "https://github.com/Ruvelo/prestashop-security-alerts",
    "authors": [
        {
            "name": "François Bultez",
            "homepage": "https://github.com/francoisbultez",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Ruvelo/security-advisories"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nyholm/psr7": "^1.8",
        "ruvelo/security-advisories": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Ruvelo\\PrestaShop\\SecurityAlerts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruvelo\\PrestaShop\\SecurityAlerts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
